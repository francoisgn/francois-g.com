---
// A project led in someone else's repository: image, name, role badge, subtitle, description, key figures as stat
// tiles, notes (licence, status), technologies, link.
import GlassCard from './GlassCard.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import type { Lead } from '../data/projects';

interface Props {
  lead: Lead;
}

const { lead } = Astro.props;
const id = `lead-${lead.name.toLowerCase()}`;
---
<GlassCard as="article" class="lead-card" aria-labelledby={id}>
  {lead.visual && <Shot visual={lead.visual} />}
  <div class="body">
    <div class="title-row">
      <h3 id={id}>{lead.name}</h3>
      <Chip label={lead.role} variant="accent" />
    </div>
    <p class="subtitle">{lead.subtitle}</p>
    <p class="desc">{lead.description}</p>
    <dl class="facts">
      {lead.facts.map((f) => (
        <div class="fact">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
    <ul class="notes">
      {lead.notes.map((n) => <li>{n}</li>)}
    </ul>
    <ul class="chips" aria-label="Technologies">
      {lead.tech.map((t) => <li><Chip label={t} variant="tech" /></li>)}
    </ul>
    <p class="actions">
      <a class="btn" href={lead.href} target="_blank" rel="noopener">
        <Icon name="branch" />
        <span>Swift rewrite on GitHub</span>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </p>
  </div>
</GlassCard>

<style>
  :global(.lead-card) {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
    padding: 20px 28px 28px 20px;
  }

  .body { padding-top: 8px; }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  h3 { font-size: 1.75rem; font-weight: 700; }

  .subtitle { margin: 6px 0 0; font-weight: 600; }

  .desc { margin: 10px 0 18px; color: var(--text-2); }

  /* Stat tiles: figure on top (dd, visually first), label below; dt stays first in the markup. */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0 0 16px;
  }

  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--chip-bg);
    border: 0.5px solid var(--chip-border);
    box-shadow: inset 0 1px 0 var(--specular);
  }

  dd {
    margin: 0;
    font-family: var(--font-rounded);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  dt { margin-top: 2px; font-size: 14px; color: var(--text-2); line-height: 1.3; }

  .notes {
    margin: 0 0 16px;
    padding-left: 1.1em;
    font-size: 15px;
    color: var(--text-2);
  }

  .notes li + li { margin-top: 4px; }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .actions { margin: 18px 0 0; }

  @media (max-width: 860px) {
    :global(.lead-card) { grid-template-columns: 1fr; padding: 12px 12px 24px; gap: 18px; }
    .body { padding: 0 8px; }
  }
</style>
