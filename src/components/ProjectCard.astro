---
// Own project: optional image, name (links to the repository; the whole card is the target), maturity chip, stars when
// known and above zero, description, technology chips, what comes next.
import GlassCard from './GlassCard.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import Stars from './Stars.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  stars?: number;
}

const { project, stars } = Astro.props;
const url = `https://github.com/${project.repo}`;
const id = `project-${project.repo.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<GlassCard as="article" interactive class="project-card" aria-labelledby={id}>
  {project.visual && <Shot visual={project.visual} class="project-shot" />}
  <div class="top">
    <h3 id={id}>
      <a class="stretched" href={url} target="_blank" rel="noopener">
        {project.name}
        <span class="visually-hidden">on GitHub (opens in a new tab)</span>
      </a>
    </h3>
    {project.status && <Chip label={project.status} variant="accent" />}
    <Stars count={stars} />
  </div>
  <p class="desc">{project.description}</p>
  <ul class="tech" aria-label="Technologies">
    {project.tech.map((t) => <li><Chip label={t} variant="tech" /></li>)}
  </ul>
  {project.next && <p class="next">{project.next}</p>}
  <p class="repo" aria-hidden="true">
    <Icon name="github" size={15} />
    <span>{project.repo}</span>
    <Icon name="arrow" size={14} />
  </p>
</GlassCard>

<style>
  :global(.project-card) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
  }

  :global(.project-shot) { margin-bottom: 4px; }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  h3 { font-size: 1.3rem; font-weight: 700; overflow-wrap: anywhere; }

  /* Stars stay on the right of the row. */
  .top :global(.stars) { margin-left: auto; }

  .next {
    margin: 2px 0 0;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    background: var(--chip-bg);
    border: 0.5px dashed var(--chip-border);
  }

  .stretched {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is the link target. */
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-card);
  }

  .stretched:focus-visible { outline: none; }
  .stretched:focus-visible::after { outline: 3px solid var(--focus); outline-offset: 3px; }

  .desc { margin: 0; color: var(--text-2); font-size: 16px; flex: 1; }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .repo {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 0.5px solid var(--chip-border);
    font-family: var(--font-rounded);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }

  .repo span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
