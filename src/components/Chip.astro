---
// Glossy pill for a technology, a feature or a status. A known technology gets its colour dot (decorative).
interface Props {
  label: string;
  /** `tech` shows the colour dot; `plain` a neutral pill; `accent` a tinted one (e.g. "contribution"). */
  variant?: 'tech' | 'plain' | 'accent';
}

const { label, variant = 'plain' } = Astro.props;

// Brand-ish colours of each technology, used only for the dot.
const dots: Record<string, string> = {
  Swift: '#f05138',
  SwiftUI: '#0a84ff',
  'Objective-C': '#438eff',
  Python: '#3776ab',
  Rust: '#ce422b',
  Docker: '#2496ed',
  Shell: '#4eaa25',
  'GitHub Actions': '#2088ff',
  'macOS 26': '#8e8e93',
  iOS: '#8e8e93',
};
const dot = variant === 'tech' ? (dots[label] ?? '#8e8e93') : undefined;
---
<span class:list={['chip', variant]}>
  {dot && <span class="dot" style={`--dot:${dot}`} aria-hidden="true" />}
  <slot name="icon" />
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border-radius: 999px;
    font-family: var(--font-rounded);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.005em;
    color: var(--text);
    background: var(--chip-bg);
    border: 0.5px solid var(--chip-border);
    box-shadow: inset 0 1px 0 var(--specular), 0 1px 2px rgb(0 0 0 / 0.06);
    white-space: nowrap;
  }

  .accent {
    color: var(--accent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 16%, transparent), color-mix(in srgb, var(--accent) 6%, transparent));
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.7), transparent 55%), var(--dot);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.15);
  }
</style>
