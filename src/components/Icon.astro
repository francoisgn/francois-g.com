---
// Inline SVG icons (no icon font, no third-party request). Decorative: the link or button carries the text.
export type IconName =
  | 'github' | 'linkedin' | 'coffee' | 'star' | 'arrow' | 'globe' | 'support' | 'shield' | 'branch' | 'appstore';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox={name === 'github' ? '0 0 16 16' : '0 0 24 24'}
  aria-hidden="true"
  focusable="false"
  fill={name === 'github' || name === 'star' ? 'currentColor' : 'none'}
  stroke={name === 'github' || name === 'star' ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'github' && (
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
  )}
  {name === 'linkedin' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="M8 10.5V16.5M8 7.5v.01M12 16.5v-6M12 13a2.5 2.5 0 0 1 5 0v3.5" />
    </>
  )}
  {name === 'coffee' && (
    <path d="M4 9h12v4.5A5.5 5.5 0 0 1 10.5 19h-1A5.5 5.5 0 0 1 4 13.5V9ZM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3.5c-.6.8-.6 1.7 0 2.5M12 3.5c-.6.8-.6 1.7 0 2.5" />
  )}
  {name === 'star' && (
    <path d="M12 2.8l2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.24l-5.66 2.97 1.08-6.3-4.57-4.46 6.32-.92L12 2.8Z" />
  )}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
    </>
  )}
  {name === 'support' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.6" />
      <path d="M5.6 5.6l3.9 3.9M14.5 14.5l3.9 3.9M18.4 5.6l-3.9 3.9M9.5 14.5l-3.9 3.9" />
    </>
  )}
  {name === 'shield' && <path d="M12 3l7 2.8v5.4c0 4.4-2.9 8.3-7 9.8-4.1-1.5-7-5.4-7-9.8V5.8L12 3Z" />}
  {name === 'branch' && (
    <>
      <circle cx="6" cy="5.5" r="2.2" />
      <circle cx="6" cy="18.5" r="2.2" />
      <circle cx="18" cy="8" r="2.2" />
      <path d="M6 7.7v8.6M18 10.2c0 4-4 4.5-9.8 6.6" />
    </>
  )}
  {name === 'appstore' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <path d="M9.8 7.5 15.5 17M14.2 7.5 8.5 17M7 14.2h10" />
    </>
  )}
</svg>

<style>
  .icon { flex: none; display: block; }
</style>
