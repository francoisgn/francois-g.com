---
// Translucent card: blurred backdrop, specular top edge, layered shadow. `interactive` adds the hover lift.
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  interactive?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { as: Tag = 'div', interactive = false, class: className, ...rest } = Astro.props;
---
<Tag class:list={['glass', { interactive }, className]} {...rest}>
  <slot />
</Tag>

<style>
  .glass {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-card);
    background: var(--glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 1px solid var(--glass-border);
    box-shadow:
      inset 0 1px 0 var(--specular),
      inset 0 0 0 0.5px var(--glass-edge),
      var(--shadow);
  }

  /* Specular sheen on the top edge, fading down: the "light on glass" highlight. */
  .glass::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, var(--specular) 0%, transparent 38%);
    opacity: 0.35;
  }

  .interactive {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
  }

  .interactive:hover,
  .interactive:focus-within {
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 var(--specular),
      inset 0 0 0 0.5px var(--glass-edge),
      var(--shadow-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive:hover,
    .interactive:focus-within { transform: none; }
  }

  /* Without backdrop-filter the glass would let the gradient through too clearly: make it more opaque. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass { background: var(--glass-strong); }
  }
</style>
