---
// The one page: header, the harness (featured), the project led, the ArtCraft Crafting Apps, the App Store app,
// the other projects, footer. Content comes from src/data/.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import LeadCard from '../components/LeadCard.astro';
import CraftCard from '../components/CraftCard.astro';
import AppCard from '../components/AppCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stars from '../components/Stars.astro';
import { apps } from '../data/apps';
import { belayline, craft, projects, swiftHfr } from '../data/projects';
import { starsFor } from '../lib/stars';

const stars = await starsFor([belayline, craft, ...projects]);
---
<Layout
  title="François G.: platform manager, agentic engineering, apps and open source"
  description="François G., platform manager by day (multicloud PaaS, cloud transformation, FinOps). Side projects by night: the Belayline agentic harness, the SwiftHFR rewrite, ArtCraft's LightCraft and PdfCraft, the Crédit Immo and SoHo Monitor apps and more."
>
  <Header />
  <main id="main">
    <section id="belayline" aria-labelledby="belayline-title">
      <p class="eyebrow">How I build</p>
      <h2 id="belayline-title">The harness</h2>
      <FeaturedCard harness={belayline} stars={stars.get(belayline.repo)} />
    </section>

    <section id="swifthfr" aria-labelledby="swifthfr-title">
      <p class="eyebrow">Leading</p>
      <h2 id="swifthfr-title">A native rewrite</h2>
      <LeadCard lead={swiftHfr} />
    </section>

    <section id="artcraft" aria-labelledby="artcraft-title">
      <p class="eyebrow">Contributing</p>
      <h2 id="artcraft-title">ArtCraft Crafting Apps</h2>
      <p class="intro">
        <a href={craft.site} target="_blank" rel="noopener">{craft.name}<span class="visually-hidden"> (opens in a new tab)</span></a>
        <Stars count={stars.get(craft.repo)} compact />
        builds the Crafting Apps: free, open-source creative tools, each written from scratch in pure Rust. The
        projects are theirs; I contribute to the suite, app after app.
      </p>
      <div class="grid two">
        {craft.apps.map((a) => <CraftCard app={a} />)}
      </div>
    </section>

    <section id="apps" aria-labelledby="apps-title">
      <p class="eyebrow">Side projects</p>
      <h2 id="apps-title">Apps</h2>
      <div class="grid two">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <p class="eyebrow">Open source</p>
      <h2 id="projects-title">Other projects</h2>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} stars={stars.get(p.repo)} />)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { display: grid; gap: 56px; padding: 40px 0 56px; }

  section { scroll-margin-top: 24px; min-width: 0; }

  .eyebrow { margin-left: 6px; }

  h2 {
    margin: 0 0 18px 6px;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2rem);
    font-weight: 700;
  }

  .intro {
    margin: -6px 6px 20px;
    max-width: 75ch;
    color: var(--text-2);
  }

  .intro a { font-weight: 600; }

  .intro :global(.stars) { display: inline-flex; margin: 0 4px 0 2px; vertical-align: -1px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  .grid.two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
</style>
