---
// The one page: header, then the projects by category: the agentic harness (featured), enterprise grade, iOS apps
// (SwiftHFR led, Crédit Immo), the ArtCraft Crafting Apps contributed to, homelab grade; footer. Content comes from
// src/data/.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import LeadCard from '../components/LeadCard.astro';
import CraftCard from '../components/CraftCard.astro';
import AppCard from '../components/AppCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stars from '../components/Stars.astro';
import { apps } from '../data/apps';
import { belayline, craft, enterprise, homelab, swiftHfr } from '../data/projects';
import { starsFor } from '../lib/stars';

const stars = await starsFor([belayline, craft, ...enterprise, ...homelab]);
const iosApps = apps.filter((a) => a.category === 'ios');
const homelabApps = apps.filter((a) => a.category === 'homelab');
---
<Layout
  title="François G.: cloud platforms, platform engineering and agentic engineering"
  description="François G., Group Cloud Center of Excellence Lead and Head of Platform Engineering: multicloud platforms (Google Cloud, AWS, Alibaba Cloud) and internal developer platforms. Projects: the Belayline agentic harness, enterprise-grade platform tools, the SwiftHFR and Crédit Immo iOS apps, ArtCraft contributions and homelab tools."
>
  <Header />
  <main id="main">
    <section id="harness" aria-labelledby="harness-title">
      <p class="eyebrow">Agentic harness</p>
      <h2 id="harness-title">How I build</h2>
      <FeaturedCard harness={belayline} stars={stars.get(belayline.repo)} />
    </section>

    <section id="enterprise" aria-labelledby="enterprise-title">
      <p class="eyebrow">Enterprise grade</p>
      <h2 id="enterprise-title">Platform tools</h2>
      <p class="intro">Open-source building blocks for a company's cloud and developer platform.</p>
      <div class="grid two">
        {enterprise.map((p) => <ProjectCard project={p} stars={stars.get(p.repo)} />)}
      </div>
    </section>

    <section id="ios" aria-labelledby="ios-title">
      <p class="eyebrow">iOS apps</p>
      <h2 id="ios-title">Native on iPhone</h2>
      <div class="stack">
        <LeadCard lead={swiftHfr} />
        {iosApps.map((app) => <AppCard app={app} wide />)}
      </div>
    </section>

    <section id="artcraft" aria-labelledby="artcraft-title">
      <p class="eyebrow">Contributing</p>
      <h2 id="artcraft-title">ArtCraft Crafting Apps</h2>
      <p class="intro">
        <a href={craft.site} target="_blank" rel="noopener">{craft.name}<span class="visually-hidden"> (opens in a new tab)</span></a>
        <Stars count={stars.get(craft.repo)} compact />
        builds the Crafting Apps: free, open-source creative tools, each written from scratch in pure Rust. The
        projects are theirs; I contribute to the suite, app after app.
      </p>
      <div class="grid two">
        {craft.apps.map((a) => <CraftCard app={a} />)}
      </div>
    </section>

    <section id="homelab" aria-labelledby="homelab-title">
      <p class="eyebrow">Homelab grade</p>
      <h2 id="homelab-title">Small office, home lab</h2>
      <p class="intro">Tools for the Mac, the NAS and the network at home, built with the same rigour.</p>
      <div class="stack">
        {homelabApps.map((app) => <AppCard app={app} wide />)}
        <div class="grid">
          {homelab.map((p) => <ProjectCard project={p} stars={stars.get(p.repo)} />)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { display: grid; gap: 56px; padding: 40px 0 56px; }

  section { scroll-margin-top: 24px; min-width: 0; }

  .eyebrow { margin-left: 6px; }

  h2 {
    margin: 0 0 18px 6px;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2rem);
    font-weight: 700;
  }

  .intro {
    margin: -6px 6px 20px;
    max-width: 75ch;
    color: var(--text-2);
  }

  .intro a { font-weight: 600; }

  .intro :global(.stars) { display: inline-flex; margin: 0 4px 0 2px; vertical-align: -1px; }

  .stack { display: grid; gap: 20px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  .grid.two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
</style>
