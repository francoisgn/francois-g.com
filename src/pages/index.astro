---
// The one page: header, apps, open source, footer. Content comes from src/data/.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppCard from '../components/AppCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { apps } from '../data/apps';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
import { starsFor } from '../lib/stars';

const stars = await starsFor(projects);
---
<Layout
  title={`${profile.name}: apps and open source`}
  description="iPhone apps and open-source projects by François G.: Crédit Immo, soho-monitor, Belayline, seed-box and more."
>
  <Header />
  <main id="main">
    <section id="apps" aria-labelledby="apps-title">
      <h2 id="apps-title">Apps</h2>
      <div class="stack">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    </section>
    <section id="open-source" aria-labelledby="oss-title">
      <h2 id="oss-title">Open source</h2>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} stars={stars.get(p.repo)} />)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { display: grid; gap: 48px; padding: 40px 0 56px; }

  section { scroll-margin-top: 24px; }

  h2 {
    margin: 0 0 18px 6px;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2rem);
    font-weight: 700;
  }

  .stack { display: grid; gap: 20px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }
</style>
